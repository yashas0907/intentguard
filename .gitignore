# ==========================================
# IntentGuard - Safe .gitignore Configuration
# ==========================================

# Secrets and Private Credentials (CRITICAL)
*.pem
*.key
*.seed
*.priv
*keypair*.json
id.json
deploy-keypair.json
agent-keypair.json
owner-keypair.json
wallet-keypair.json
secrets/
.secret/
private/

# Environment Variables
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Build and Compilation Artifacts
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# Rust & Anchor Output
target/
.anchor/
test-ledger/
**/*.rs.bk

# Local Logs & Diagnostics
logs/
*.log

# Editor and IDE Directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary & Test Dumps
.cache/
tmp/
temp/
coverage/
.nyc_output/

