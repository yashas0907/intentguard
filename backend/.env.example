# Copy to backend/.env. Never commit .env. Never prefix these with VITE_.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Path to the agent's Devnet-only keypair. It can only propose, never move funds.
# Create it with: solana-keygen new --no-bip39-passphrase --silent --outfile agent-keypair.json
AGENT_KEYPAIR_PATH=./agent-keypair.json

# The server refuses to start on any network other than Devnet.
RPC_URL=https://api.devnet.solana.com

# What people call the single approved recipient in plain English.
APPROVED_RECIPIENT_LABEL=server host

PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
